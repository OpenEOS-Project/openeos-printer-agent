[Unit]
Description=OpenEOS Printer Agent
Documentation=https://github.com/openeos/openeos-printer-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openeos
Group=openeos
WorkingDirectory=/opt/openeos-printer-agent
ExecStart=/opt/openeos-printer-agent/venv/bin/python -m src.main --config /opt/openeos-printer-agent/config/config.yaml
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Security hardening
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

# Allow USB printer access
SupplementaryGroups=lp plugdev

# Allow write access to cache, logs, and the persisted device token +
# crash-safe job queue (both default under /var/lib/openeos-printer — see
# device_token_file / job_store_file in src/config.py). Without this,
# self-registration silently fails to persist under ProtectSystem=strict
# and the agent re-registers with a new token/verification code on every
# restart.
ReadWritePaths=/opt/openeos-printer-agent/cache /var/log/openeos-printer /var/lib/openeos-printer

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
